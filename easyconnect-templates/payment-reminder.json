{
  "name": "Daily Payment Reminder",
  "description": "Send payment reminders every morning at 9 AM",
  "version": "1.0",
  "trigger": {
    "type": "schedule",
    "cron": "0 9 * * *",
    "timezone": "UTC"
  },
  "actions": [
    {
      "type": "query_contract",
      "contract": "LENDING_POOL_ADDRESS",
      "function": "getActiveLoans",
      "save_as": "activeLoans"
    },
    {
      "type": "filter",
      "data": "${activeLoans}",
      "condition": "paymentDueToday == true",
      "save_as": "dueLoans"
    },
    {
      "type": "foreach",
      "items": "${dueLoans}",
      "actions": [
        {
          "type": "telegram_message",
          "bot_token": "YOUR_TELEGRAM_BOT_TOKEN",
          "chat_id": "${item.borrowerChatId}",
          "message": "⏰ Payment Reminder\n\nLoan #${item.loanId}\nAmount Due: ${item.dailyAmount} QUBIC\nDue Date: Today\n\nPay now to maintain your credit score!"
        }
      ]
    }
  ]
}

